# Safe local defaults only. Do not put credentials in this file.
ZORACLEFLUX_ENV=local-pilot
ZORACLEFLUX_DATA_DIR=.zoracleflux
ZORACLEFLUX_DATABASE=.zoracleflux/pilot.sqlite3
ZORACLEFLUX_AUDIT=.zoracleflux/audit.jsonl
ZORACLEFLUX_LOG_LEVEL=INFO
# Leave unset/empty. A future production secret must come from an approved
# secret manager, never from source control, Compose environment, or logs.
ZORACLEFLUX_SECRET_FILE=

